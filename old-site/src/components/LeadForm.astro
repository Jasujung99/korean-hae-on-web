---
import { siteConfig } from "../lib/site";

type Variant = "coaching" | "class" | "contact" | "refund";

interface Props {
  variant: Variant;
  endpoint: string;
  successPath: string;
}

const { variant, endpoint, successPath } = Astro.props;

const config = {
  coaching: {
    formId: "coaching-application",
    leadType: "coaching",
    title: "무료 발음 체크 신청",
    submitLabel: "신청 내용 보내기",
  },
  class: {
    formId: "class-inquiry",
    leadType: "class",
    title: "수업 상담 신청",
    submitLabel: "상담 신청 보내기",
  },
  contact: {
    formId: "general-inquiry",
    leadType: "contact",
    title: "문의 보내기",
    submitLabel: "문의 보내기",
  },
  refund: {
    formId: "refund-request",
    leadType: "refund",
    title: "환불 요청",
    submitLabel: "환불 요청 보내기",
  },
}[variant];

const isDemo = !endpoint;
---

<form
  class="lead-form"
  method="post"
  action={endpoint || successPath}
  novalidate
  data-lead-form
  data-form-id={config.formId}
  data-lead-type={config.leadType}
  data-endpoint={endpoint}
  data-success-path={successPath}
  data-demo={String(isDemo)}
>
  <div class="form-grid">
    <div class="field field-full">
      <p class="page-kicker">APPLICATION</p>
      <h2>{config.title}</h2>
      <p class="field-hint">필수 항목은 *로 표시했습니다. Required fields are marked with *.</p>
    </div>

    {isDemo && (
      <p class="form-mode-notice" role="note">
        현재는 개발용 접수 흐름입니다. 외부 폼 연결 전까지 입력 내용은 전송·저장되지 않습니다.
      </p>
    )}

    <div class="hp-field" aria-hidden="true">
      <label for={`${config.formId}-website`}>웹사이트</label>
      <input id={`${config.formId}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="form_type" value={config.leadType} />
    <input type="hidden" name="source_path" value={Astro.url.pathname} />

    {(variant === "coaching" || variant === "class" || variant === "contact") && (
      <>
        <div class="field">
          <label for={`${config.formId}-name`}>이름 또는 불리고 싶은 이름 / Name *</label>
          <input id={`${config.formId}-name`} name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for={`${config.formId}-email`}>이메일 / Email *</label>
          <input id={`${config.formId}-email`} name="email" type="email" autocomplete="email" required />
        </div>
      </>
    )}

    {variant === "coaching" && (
      <>
        <div class="field">
          <label for={`${config.formId}-language`}>안내 언어 / Preferred language *</label>
          <select id={`${config.formId}-language`} name="preferred_language" required>
            <option value="">선택해 주세요</option>
            <option value="ko">한국어</option>
            <option value="en">English</option>
            <option value="other">다른 언어 / Other</option>
          </select>
        </div>
        <div class="field">
          <label for={`${config.formId}-timezone`}>현재 시간대 / Time zone *</label>
          <input id={`${config.formId}-timezone`} name="timezone" type="text" value="Asia/Seoul (UTC+9)" required />
        </div>
        <div class="field">
          <label for={`${config.formId}-availability`}>가능한 요일·시간 / Availability *</label>
          <input id={`${config.formId}-availability`} name="availability" type="text" placeholder="예: 화·목 19:00 이후" required />
        </div>
        <div class="field">
          <label for={`${config.formId}-level`}>현재 한국어 수준 / Korean level</label>
          <select id={`${config.formId}-level`} name="level">
            <option value="">잘 모르겠어요</option>
            <option value="beginner">초급 / Beginner</option>
            <option value="intermediate">중급 / Intermediate</option>
            <option value="advanced">고급 / Advanced</option>
          </select>
        </div>
        <div class="field field-full">
          <label for={`${config.formId}-challenge`}>어렵게 느끼는 발음이나 상황</label>
          <textarea id={`${config.formId}-challenge`} name="challenge" placeholder="예: 받침 소리, 주문할 때 말하기"></textarea>
        </div>
      </>
    )}

    {variant === "class" && (
      <>
        <div class="field">
          <label for={`${config.formId}-level`}>현재 한국어 수준 / Korean level *</label>
          <select id={`${config.formId}-level`} name="level" required>
            <option value="">선택해 주세요</option>
            <option value="beginner">초급 / Beginner</option>
            <option value="intermediate">중급 / Intermediate</option>
            <option value="advanced">고급 / Advanced</option>
          </select>
        </div>
        <div class="field">
          <label for={`${config.formId}-service`}>관심 수업 / Class type *</label>
          <select id={`${config.formId}-service`} name="service_type" required>
            <option value="">선택해 주세요</option>
            <option value="one_to_one">1:1 맞춤 수업</option>
            <option value="small_group">소그룹 수업</option>
            <option value="kiip">KIIP 보조 수업</option>
          </select>
        </div>
        <div class="field">
          <label for={`${config.formId}-delivery`}>희망 방식 / Preferred format *</label>
          <select id={`${config.formId}-delivery`} name="delivery" required>
            <option value="">선택해 주세요</option>
            <option value="online">온라인</option>
            <option value="chungcheong">충청권 대면</option>
            <option value="either">둘 다 가능</option>
          </select>
        </div>
        <div class="field">
          <label for={`${config.formId}-availability`}>가능한 요일·시간</label>
          <input id={`${config.formId}-availability`} name="availability" type="text" placeholder="예: 평일 18:00 이후" />
        </div>
        <div class="field field-full">
          <label for={`${config.formId}-goal`}>학습 목표 / Learning goal *</label>
          <textarea id={`${config.formId}-goal`} name="goal" required></textarea>
        </div>
      </>
    )}

    {variant === "contact" && (
      <>
        <div class="field field-full">
          <label for={`${config.formId}-topic`}>문의 유형 / Topic *</label>
          <select id={`${config.formId}-topic`} name="topic" required>
            <option value="">선택해 주세요</option>
            <option value="coaching">무료 발음 체크</option>
            <option value="class">수업</option>
            <option value="study_kit">학습 키트·결제</option>
            <option value="refund">환불</option>
            <option value="partnership">협업</option>
            <option value="other">기타</option>
          </select>
        </div>
        <div class="field field-full">
          <label for={`${config.formId}-message`}>문의 내용 / Message *</label>
          <textarea id={`${config.formId}-message`} name="message" required></textarea>
        </div>
      </>
    )}

    {variant === "refund" && (
      <>
        <div class="field">
          <label for={`${config.formId}-email`}>주문 이메일 / Order email *</label>
          <input id={`${config.formId}-email`} name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for={`${config.formId}-order`}>주문번호 / Order number *</label>
          <input id={`${config.formId}-order`} name="order_number" type="text" required />
        </div>
        <div class="field field-full">
          <label for={`${config.formId}-product`}>상품명 / Product *</label>
          <input id={`${config.formId}-product`} name="product_name" type="text" value={siteConfig.kit.name} required />
        </div>
        <div class="field field-full">
          <label for={`${config.formId}-message`}>요청 내용 / Request *</label>
          <textarea id={`${config.formId}-message`} name="message" required></textarea>
        </div>
      </>
    )}

    <div class="field field-full checkbox-field">
      <input id={`${config.formId}-consent`} name="privacy_consent" type="checkbox" value="agreed" required />
      <label for={`${config.formId}-consent`}>
        문의 처리를 위해 입력한 개인정보를 수집·이용하는 데 동의합니다. 자세한 내용은 <a href="/privacy/">개인정보 처리방침</a>에서 확인할 수 있습니다. *
      </label>
    </div>

    <p class="form-status" role="alert" aria-live="assertive" data-form-status></p>
    <button class="site-button form-submit" type="submit" data-submit-button>{config.submitLabel}</button>
    <noscript>
      <p class="form-mode-notice">
        이 양식을 보내려면 JavaScript가 필요합니다.{siteConfig.contactEmail && <> 대신 <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>로 문의할 수 있습니다.</>}
      </p>
    </noscript>
    {siteConfig.contactEmail && (
      <p class="form-privacy">전송이 계속 실패하면 <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>로 알려주세요.</p>
    )}
  </div>
</form>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>("[data-lead-form]");

  function emit(detail: Record<string, string>) {
    window.dispatchEvent(new CustomEvent("haeon:track", { detail }));
  }

  forms.forEach((form) => {
    const formId = form.dataset.formId || "unknown-form";
    const leadType = form.dataset.leadType || "unknown";
    const endpoint = form.dataset.endpoint || "";
    const successPath = form.dataset.successPath || "/";
    const successStoragePath = new URL(successPath, window.location.origin).pathname;
    const status = form.querySelector<HTMLElement>("[data-form-status]");
    const submit = form.querySelector<HTMLButtonElement>("[data-submit-button]");
    let started = false;

    if (formId === "general-inquiry") {
      const topic = new URLSearchParams(window.location.search).get("topic");
      const topicSelect = form.elements.namedItem("topic");
      if (topic && topicSelect instanceof HTMLSelectElement) {
        const isSupported = Array.from(topicSelect.options).some((option) => option.value === topic);
        if (isSupported) topicSelect.value = topic;
      }
    }

    form.addEventListener("input", (event) => {
      if (event.target instanceof HTMLElement) event.target.removeAttribute("aria-invalid");
    });

    form.addEventListener("input", () => {
      if (started) return;
      started = true;
      emit({ event: "form_start", form_id: formId, lead_type: leadType });
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!status || !submit) return;

      const honeypot = form.elements.namedItem("website");
      if (honeypot instanceof HTMLInputElement && honeypot.value) {
        window.location.assign(successPath);
        return;
      }

      if (!form.checkValidity()) {
        status.dataset.state = "error";
        status.textContent = "필수 항목과 이메일 형식을 확인해 주세요.";
        form.querySelectorAll<HTMLElement>(":invalid").forEach((field) => field.setAttribute("aria-invalid", "true"));
        const invalid = form.querySelector<HTMLElement>(":invalid");
        invalid?.focus();
        emit({ event: "form_error", form_id: formId, lead_type: leadType, error_code: "validation" });
        return;
      }

      submit.disabled = true;
      const originalLabel = submit.textContent || "보내기";
      submit.textContent = "보내는 중…";
      status.textContent = "";
      delete status.dataset.state;

      try {
        if (endpoint) {
          const controller = new AbortController();
          const timeout = window.setTimeout(() => controller.abort(), 12000);
          const response = await fetch(endpoint, {
            method: "POST",
            body: new FormData(form),
            headers: { Accept: "application/json" },
            signal: controller.signal,
          });
          window.clearTimeout(timeout);
          if (!response.ok) throw new Error(`submit_${response.status}`);
          sessionStorage.setItem(`haeon:confirmed:${successStoragePath}`, String(Date.now()));
        } else {
          await new Promise((resolve) => window.setTimeout(resolve, 350));
          sessionStorage.setItem(`haeon:demo:${successStoragePath}`, String(Date.now()));
        }
        window.location.assign(successPath);
      } catch (error) {
        status.dataset.state = "error";
        status.textContent = "전송하지 못했습니다. 잠시 후 다시 시도해 주세요.";
        submit.disabled = false;
        submit.textContent = originalLabel;
        emit({ event: "form_error", form_id: formId, lead_type: leadType, error_code: "network" });
      }
    });
  });
</script>
