---
interface Props {
  href: string;
  label: string;
  variant?: "primary" | "secondary" | "quiet";
  analyticsId: string;
  analyticsLocation: string;
  analyticsEvent?: string;
  learningPath?: string;
  itemId?: string;
  itemName?: string;
  itemCategory?: string;
  currency?: string;
  value?: number;
  outboundDomain?: string;
  disabled?: boolean;
  external?: boolean;
}

const {
  href,
  label,
  variant = "primary",
  analyticsId,
  analyticsLocation,
  analyticsEvent = "cta_click",
  learningPath,
  itemId,
  itemName,
  itemCategory,
  currency,
  value,
  outboundDomain,
  disabled = false,
  external = false,
} = Astro.props;

const className = [
  "site-button",
  variant === "secondary" && "site-button-secondary",
  variant === "quiet" && "site-button-quiet",
].filter(Boolean).join(" ");
---

<a
  class={className}
  href={disabled ? undefined : href}
  aria-disabled={disabled ? "true" : undefined}
  tabindex={disabled ? "-1" : undefined}
  target={external && !disabled ? "_blank" : undefined}
  rel={external && !disabled ? "noreferrer" : undefined}
  data-analytics-event={disabled ? undefined : analyticsEvent}
  data-analytics-id={analyticsId}
  data-analytics-location={analyticsLocation}
  data-destination-path={href}
  data-learning-path={learningPath}
  data-item-id={itemId}
  data-item-name={itemName}
  data-item-category={itemCategory}
  data-currency={currency}
  data-value={value}
  data-outbound-domain={outboundDomain}
>
  {label}<span aria-hidden="true">→</span>
</a>
