---
import ButtonLink from "../../components/ButtonLink.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../lib/site";

const path = "/thanks/inquiry/";
const title = "문의 접수 상태 | 해온";
const description = "해온 수업 및 일반 문의의 접수 상태와 다음 단계를 확인합니다.";
---

<BaseLayout title={title} description={description} canonicalPath={path} noindex bodyClass="thanks-page">
  <section class="content-section thanks-section">
    <div class="page-shell">
      <div class="thanks-panel" data-thanks-panel data-state="checking">
        <div class="thanks-mark" data-thanks-mark aria-hidden="true">…</div>
        <div class="thanks-status" role="status" aria-live="polite" aria-atomic="true">
          <p class="page-kicker" data-thanks-kicker>CHECKING STATUS</p>
          <h1 class="page-title" data-thanks-title>접수 상태를 확인하고 있습니다</h1>
          <p class="page-lead" data-thanks-message>잠시만 기다려 주세요.</p>
        </div>

        <div class="thanks-details" data-confirmed-details hidden>
          <dl class="fact-list">
            <div><dt>답변 시간</dt><dd>{siteConfig.responseTime}</dd></div>
            <div><dt>답변 방법</dt><dd>입력한 이메일로 필요한 내용을 안내합니다.</dd></div>
          </dl>
        </div>

        <p class="thanks-notice" data-demo-notice hidden>
          이 화면은 문의 흐름을 확인하기 위한 데모입니다. 입력한 내용은 외부로 전송되거나 저장되지 않았고, 실제 문의도 접수되지 않았습니다.
        </p>

        <p class="thanks-notice thanks-notice-neutral" data-unknown-notice hidden>
          이 주소를 직접 열었거나 접수 확인 정보가 만료되었습니다. 실제 문의 여부가 확실하지 않다면 문의 페이지에서 다시 확인해 주세요.
        </p>

        <div class="section-actions thanks-actions" data-confirmed-actions hidden>
          <ButtonLink href="/start/" label="다른 학습 방법 보기" analyticsId="thanks-inquiry-start" analyticsLocation="thanks-inquiry" />
          <ButtonLink href="/" label="홈으로 돌아가기" variant="secondary" analyticsId="thanks-inquiry-home" analyticsLocation="thanks-inquiry" />
        </div>

        <div class="section-actions thanks-actions" data-demo-actions hidden>
          <ButtonLink href="/contact/" label="문의 페이지로 돌아가기" analyticsId="thanks-inquiry-demo-back" analyticsLocation="thanks-inquiry" />
          <ButtonLink href="/" label="홈으로 돌아가기" variant="secondary" analyticsId="thanks-inquiry-demo-home" analyticsLocation="thanks-inquiry" />
        </div>

        <div class="section-actions thanks-actions" data-unknown-actions hidden>
          <ButtonLink href="/contact/" label="문의 다시 보내기" analyticsId="thanks-inquiry-unknown-back" analyticsLocation="thanks-inquiry" />
          <ButtonLink href="/" label="홈으로 돌아가기" variant="secondary" analyticsId="thanks-inquiry-unknown-home" analyticsLocation="thanks-inquiry" />
        </div>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ path }}>
  function initInquiryThanks() {
    const panel = document.querySelector("[data-thanks-panel]");
    const mark = document.querySelector("[data-thanks-mark]");
    const kicker = document.querySelector("[data-thanks-kicker]");
    const title = document.querySelector("[data-thanks-title]");
    const message = document.querySelector("[data-thanks-message]");
    if (!panel || !mark || !kicker || !title || !message) return;
    const inquiryType = new URLSearchParams(window.location.search).get("type") || "contact";
    const types = {
      class: {
        title: "수업 상담 신청이 접수되었습니다",
        message: "학습 목표와 가능한 시간을 확인한 뒤 입력한 이메일로 수업 방향을 안내하겠습니다.",
        formId: "class-inquiry",
        leadType: "class",
      },
      refund: {
        title: "환불 요청이 접수되었습니다",
        message: "주문과 콘텐츠 제공 상태를 확인한 뒤 입력한 이메일로 처리 절차를 안내하겠습니다.",
        formId: "refund-request",
        leadType: "refund",
      },
      contact: {
        title: "문의가 접수되었습니다",
        message: "보내주신 내용을 확인한 뒤 입력한 이메일로 답변하겠습니다.",
        formId: "general-inquiry",
        leadType: "contact",
      },
    };
    const typeConfig = types[inquiryType] || types.contact;

    const show = (selector) => {
      const element = document.querySelector(selector);
      if (element) element.hidden = false;
    };

    try {
      const confirmedToken = sessionStorage.getItem(`haeon:confirmed:${path}`);
      const demoToken = sessionStorage.getItem(`haeon:demo:${path}`);
      const confirmedAt = Number(confirmedToken) || 0;
      const demoAt = Number(demoToken) || 0;

      if (confirmedToken && confirmedAt >= demoAt) {
        panel.dataset.state = "confirmed";
        mark.textContent = "✓";
        kicker.textContent = "INQUIRY RECEIVED";
        title.textContent = typeConfig.title;
        message.textContent = typeConfig.message;
        show("[data-confirmed-details]");
        show("[data-confirmed-actions]");

        const trackedKey = `haeon:lead-tracked:${path}`;
        if (sessionStorage.getItem(trackedKey) !== confirmedToken) {
          window.dispatchEvent(new CustomEvent("haeon:track", {
            detail: {
              event: "generate_lead",
              form_id: typeConfig.formId,
              lead_type: typeConfig.leadType,
            },
          }));
          sessionStorage.setItem(trackedKey, confirmedToken);
        }
        return;
      }

      if (demoToken) {
        panel.dataset.state = "demo";
        mark.textContent = "i";
        kicker.textContent = "DEMO COMPLETE";
        title.textContent = "데모 제출 흐름이 완료되었습니다";
        message.textContent = "화면 동작은 확인됐지만 실제 문의는 접수되지 않았습니다.";
        show("[data-demo-notice]");
        show("[data-demo-actions]");
        return;
      }
    } catch {
      // Storage can be unavailable in privacy-restricted browsing modes.
    }

    panel.dataset.state = "unknown";
    mark.textContent = "?";
    kicker.textContent = "STATUS NOT FOUND";
    title.textContent = "접수 상태를 확인할 수 없습니다";
    message.textContent = "이 화면만으로는 실제 문의 완료 여부를 판단할 수 없습니다.";
    show("[data-unknown-notice]");
    show("[data-unknown-actions]");
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initInquiryThanks, { once: true });
  } else {
    initInquiryThanks();
  }
  </script>
</BaseLayout>

<style>
  .thanks-section {
    display: grid;
    min-height: min(52rem, calc(100dvh - var(--header-height)));
    place-items: center;
    background:
      radial-gradient(circle at 50% 20%, rgb(93 157 232 / 0.16), transparent 26rem),
      linear-gradient(180deg, rgb(255 255 255 / 0.62), rgb(234 246 250 / 0.7));
  }

  .thanks-panel {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    padding: clamp(2rem, 6vw, 5rem);
    background: rgb(255 255 255 / 0.84);
    box-shadow: var(--shadow-soft);
  }

  .thanks-panel .page-title,
  .thanks-panel .page-lead {
    margin-inline: auto;
  }

  .thanks-panel .page-title {
    max-width: 14ch;
    font-size: clamp(2.25rem, 5vw, 4.7rem);
  }

  .thanks-panel .page-lead {
    max-width: 38rem;
  }

  .thanks-details {
    max-width: 38rem;
    margin: 2.5rem auto 0;
    text-align: left;
  }

  .thanks-notice {
    max-width: 40rem;
    margin: 2.5rem auto 0;
    border: 1px solid rgb(255 120 104 / 0.38);
    border-radius: var(--radius-md);
    padding: 1rem 1.2rem;
    color: #7a302a;
    background: #fff4f1;
    line-height: 1.7;
    text-align: left;
  }

  .thanks-notice-neutral {
    border-color: var(--color-line-strong);
    color: var(--color-text-secondary);
    background: var(--color-bg-soft);
  }

  .thanks-actions {
    justify-content: center;
  }

  .thanks-panel [hidden] {
    display: none !important;
  }

  .thanks-panel[data-state="demo"] .thanks-mark,
  .thanks-panel[data-state="unknown"] .thanks-mark {
    border-color: var(--color-line-strong);
    color: var(--color-text-secondary);
    background: var(--color-bg-soft);
    font-family: var(--font-latin);
    font-size: 1.3rem;
    font-weight: 700;
  }
</style>
