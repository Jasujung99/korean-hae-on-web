---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { siteConfig } from "../lib/site";

const title = "이용약관 | 해온 HAEON";
const description = "해온 HAEON 웹사이트, 무료 발음 체크, 수업 상담 및 디지털 학습 콘텐츠 이용 조건을 안내합니다.";
const effectiveDate = "2026년 7월 14일";

const requiredBusinessFields = [
  ["상호", import.meta.env.PUBLIC_BUSINESS_NAME],
  ["대표자명", siteConfig.business.representative],
  ["사업자등록번호", siteConfig.business.businessNumber],
  ["통신판매업 신고번호", siteConfig.business.ecommerceNumber],
  ["사업장 주소", siteConfig.business.address],
  ["문의 이메일", siteConfig.contactEmail],
] as const;

const missingBusinessFields = requiredBusinessFields
  .filter(([, value]) => !value?.trim())
  .map(([label]) => label);
---

<BaseLayout title={title} description={description} noindex bodyClass="legal-page">
  <PageHero
    kicker="TERMS"
    title="이용약관"
    lead="해온 웹사이트와 학습 서비스를 이용할 때 필요한 기본 조건과 서로의 권리·의무를 안내합니다."
    facts={[
      { label: "적용 서비스", value: "상담·수업·학습 키트" },
      { label: "시행일", value: effectiveDate },
    ]}
    analyticsLocation="terms-hero"
  />

  <section class="content-section">
    <div class="page-shell legal-layout">
      <nav class="legal-nav" aria-label="이용약관 목차">
        <a href="#purpose">목적과 정의</a>
        <a href="#effect">효력과 변경</a>
        <a href="#services">서비스 내용</a>
        <a href="#contract">신청과 계약</a>
        <a href="#user-duty">이용자 의무</a>
        <a href="#paid-content">유료 콘텐츠</a>
        <a href="#classes">수업 상담</a>
        <a href="#withdrawal">청약철회와 환불</a>
        <a href="#copyright">저작권</a>
        <a href="#suspension">서비스 중단</a>
        <a href="#dispute">분쟁 해결</a>
        <a href="#operator">운영자 정보</a>
      </nav>

      <article class="legal-copy">
        {missingBusinessFields.length > 0 && (
          <p class="policy-notice" role="alert">
            <strong>게시 전 준비가 필요합니다.</strong><br />
            실제 운영 정보 중 {missingBusinessFields.join(", ")} 항목이 비어 있습니다. 유료 콘텐츠를 공개하기 전에 환경변수와 아래 운영자 정보를 실제 내용으로 채우고 약관을 다시 검토해 주세요.
          </p>
        )}

        <section id="purpose">
          <h2>1. 목적과 용어</h2>
          <p>이 약관은 {siteConfig.business.name}(이하 “해온”)이 제공하는 웹사이트, 무료 발음 체크, 한국어 수업 상담 및 디지털 학습 콘텐츠의 이용 조건을 정하는 것을 목적으로 합니다.</p>
          <ul>
            <li>“이용자”는 이 약관에 따라 해온의 서비스를 이용하는 사람을 말합니다.</li>
            <li>“콘텐츠”는 해온이 제공하는 PDF, 영상, 이미지, 문서와 그 밖의 학습 자료를 말합니다.</li>
            <li>“유료 서비스”는 이용자가 표시된 대금을 결제한 뒤 이용할 수 있는 콘텐츠 또는 수업을 말합니다.</li>
          </ul>
        </section>

        <section id="effect">
          <h2>2. 약관의 효력과 변경</h2>
          <p>이 약관은 웹사이트에 게시하고 이용자가 서비스 이용 또는 구매 과정에서 확인할 수 있도록 함으로써 효력이 발생합니다. 해온은 관계 법령을 위반하지 않는 범위에서 약관을 변경할 수 있으며, 중요한 변경 사항은 시행 전에 변경 이유와 적용일을 웹사이트에 알립니다.</p>
          <p>변경 약관은 시행일 이후 체결되는 계약에 적용하는 것을 원칙으로 하며, 이미 체결된 계약에는 특별한 합의나 법령상 근거가 없는 한 계약 당시의 약관을 적용합니다.</p>
        </section>

        <section id="services">
          <h2>3. 제공 서비스</h2>
          <p>해온은 한국어 학습 정보, 무료 발음 체크 신청, 수업 상담, 디지털 학습 콘텐츠 소개와 외부 결제 연결 등의 서비스를 제공합니다. 구체적인 구성, 가격, 이용 기간, 제공 방식과 기술 요건은 각 서비스 또는 상품 페이지에 표시합니다.</p>
          <p>서비스의 내용이나 일정은 운영상 또는 기술상 필요한 경우 변경될 수 있습니다. 이용자에게 불리한 중요한 변경은 가능한 범위에서 미리 안내합니다.</p>
        </section>

        <section id="contract">
          <h2>4. 신청과 계약의 성립</h2>
          <p>무료 발음 체크와 수업 상담은 신청 내용을 접수한 뒤 해온이 이메일 등으로 일정 또는 상담 가능 여부를 확인해야 확정됩니다. 신청서 제출만으로 일정이 예약되거나 유료 수업 계약이 체결되는 것은 아닙니다.</p>
          <p>유료 콘텐츠 계약은 이용자가 상품 정보와 거래 조건을 확인하고 결제를 완료한 뒤, 해온 또는 외부 결제 서비스가 결제 완료와 제공 방법을 안내한 때 성립합니다.</p>
          <p>미성년자가 유료 서비스를 구매하는 경우 법정대리인의 동의가 필요할 수 있으며, 관계 법령에 따라 계약이 취소될 수 있습니다.</p>
        </section>

        <section id="user-duty">
          <h2>5. 이용자의 의무</h2>
          <p>이용자는 신청과 결제에 필요한 정보를 정확하게 제공해야 하며, 타인의 정보를 무단으로 사용하거나 서비스 운영을 방해해서는 안 됩니다. 콘텐츠를 구매 목적과 허용 범위를 벗어나 복제, 배포, 판매 또는 공개해서는 안 됩니다.</p>
        </section>

        <section id="paid-content">
          <h2>6. 유료 콘텐츠의 결제와 제공</h2>
          <p>상품 가격과 포함 내용은 결제 전에 상품 페이지에 표시합니다. 결제는 외부 결제 서비스를 통해 처리될 수 있으며, 결제 과정에는 해당 제공자의 이용 조건이 함께 적용될 수 있습니다.</p>
          <p>디지털 콘텐츠는 결제 완료 후 주문 이메일 또는 결제 화면을 통해 제공합니다. 안내를 받지 못했거나 파일에 기술적인 문제가 있는 경우 주문 정보와 함께 해온에 문의할 수 있습니다.</p>
        </section>

        <section id="classes">
          <h2>7. 무료 발음 체크와 수업 상담</h2>
          <p>무료 발음 체크와 상담 신청 자체에는 비용이 발생하지 않습니다. 유료 수업을 제안하는 경우 수업 방식, 일정, 대금, 변경 및 환불 조건을 결제 전에 별도로 안내하고 동의를 받습니다.</p>
          <p>KIIP 보조 수업은 개인 학습을 돕는 서비스이며, 해온은 법무부 사회통합프로그램의 공식 운영기관이나 평가기관이 아닙니다.</p>
        </section>

        <section id="withdrawal">
          <h2>8. 청약철회, 계약 해제와 환불</h2>
          <p>유료 서비스의 청약철회와 환불은 관계 법령, 이 약관 및 결제 전에 표시된 거래 조건에 따릅니다. 디지털 콘텐츠는 제공이 시작되었는지, 청약철회 제한에 관한 사전 고지와 동의가 있었는지, 미리보기 등 법정 조치가 제공되었는지에 따라 청약철회 가능 여부가 달라질 수 있습니다.</p>
          <p>상품이 표시·광고 또는 계약 내용과 다르게 제공된 경우 이용자는 관계 법령이 정한 범위에서 청약철회 또는 계약 해제를 요구할 수 있습니다. 구체적인 신청 방법은 <a href="/refund/">환불 안내</a>에서 확인할 수 있습니다.</p>
        </section>

        <section id="copyright">
          <h2>9. 지식재산권</h2>
          <p>웹사이트와 콘텐츠에 관한 저작권 및 그 밖의 지식재산권은 해온 또는 정당한 권리자에게 있습니다. 별도 표시가 없는 유료 콘텐츠는 구매자 개인의 비상업적 학습 목적으로만 이용할 수 있습니다.</p>
        </section>

        <section id="suspension">
          <h2>10. 서비스 중단과 책임</h2>
          <p>해온은 시스템 점검, 외부 서비스 장애, 천재지변 등 합리적으로 통제하기 어려운 사유가 있는 경우 서비스의 전부 또는 일부를 일시 중단할 수 있습니다. 이미 결제했으나 제공되지 않은 서비스가 있다면 관계 법령과 개별 거래 조건에 따라 필요한 조치를 합니다.</p>
          <p>이 약관은 해온의 고의 또는 과실로 인한 법적 책임이나 소비자에게 보장되는 권리를 부당하게 제한하지 않습니다.</p>
        </section>

        <section id="dispute">
          <h2>11. 분쟁 해결과 준거법</h2>
          <p>해온과 이용자는 분쟁이 생긴 경우 성실히 협의해 해결하도록 노력합니다. 해결되지 않는 분쟁에는 대한민국 법령을 적용하며, 관할 법원은 관계 법령이 정한 기준에 따릅니다.</p>
        </section>

        <section id="operator">
          <h2>12. 운영자 정보</h2>
          <ul>
            <li>상호: {siteConfig.business.name}</li>
            <li>대표자: {siteConfig.business.representative || "게시 전 입력 필요"}</li>
            <li>사업자등록번호: {siteConfig.business.businessNumber || "게시 전 입력 필요"}</li>
            <li>통신판매업 신고번호: {siteConfig.business.ecommerceNumber || "게시 전 입력 필요"}</li>
            <li>주소: {siteConfig.business.address || "게시 전 입력 필요"}</li>
            <li>이메일: {siteConfig.contactEmail || "게시 전 입력 필요"}</li>
          </ul>
          <p>시행일: {effectiveDate}</p>
        </section>
      </article>
    </div>
  </section>
</BaseLayout>
