{
  "name": "@haeon/learn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "해온 성인 한국어 소리 학습 앱 (개발 1단계 골격). 루트 본사이트 빌드·배포와 분리된 독립 패키지.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4400",
    "check": "astro check",
    "build": "astro check && astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "node ./dist/server/entry.mjs",
    "test": "vitest run",
    "test:smoke": "node ./scripts/smoke.mjs",
    "verify:clean": "node ./scripts/verify-clean.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.13",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
