						<pattern>1이 떡이 되다</pattern>
					</pattern_info>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					<example_info>
						<type>
							
							
							문장
							
								
						</type>
						<example>그는 깡패에게 떡이 되도록 두들겨 맞았다.</example>
					</example_info>
					
					
					
					<example_info>
						<type>
							
							
							문장
							
								
						</type>
						<example>동생은 술을 얼마나 마셨는지 떡이 되어서 집으로 돌아왔다.</example>
					</example_info>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
				</subsense_info>
				
				
				
				
				
				
				
				
				
				
				
			</subword_info>
			
			<subword_info>
				<subword>떡이 생기다</subword>
				<subword_unit>
					
						관용구
						
					
				</subword_unit>
				
				
				
				
				
				
				
				
				
				
				
				
				<subsense_info>
					<definition>이익이 생기다.</definition>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					<translation>
						<trans_lang>
						
						
						
						
						
						
						영어
						
						
						
						
						
						
						</trans_lang>
						<trans_word><![CDATA[gain tteok, rice cake]]></trans_word>
						<trans_dfn><![CDATA[To gain benefit.]]></trans_dfn>
					</translation>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					<translation>
						<trans_lang>
						
						
						
						
						
						러시아어
						
						
						
						
						
						
						
						</trans_lang>
						<trans_word><![CDATA[(досл.) находить хлеб]]></trans_word>
						<trans_dfn><![CDATA[Иметь выгоду.]]></trans_dfn>
					</translation>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					<example_info>
						<type>
							
							
							문장
							
								
						</type>
						<example>아무것도 하지 않으면서 떡이 생기기만을 기다리는 것은 어리석은 일이다.</example>
					</example_info>
					
					
					
					<example_info>
						<type>
							
							
							문장
							
								
						</type>
						<example>그가 시키는 대로 그곳에 투자를 해 보았지만 떡이 생기기는커녕 오히려 큰 손해만 보았다.</example>
					</example_info>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
				</subsense_info>
				
				
				
				
				
				
				
				
				
			</subword_info>
			
			<subword_info>
				<subword>떡 본 김에 굿 한다</subword>
				<subword_unit>
					
						
						속담
					
				</subword_unit>
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				<subsense_info>
					<definition>우연히 얻은 좋은 기회에 하려고 했던 일을 한다.</definition>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					<translation>
						<trans_lang>
						
						
						
						
						
						
						영어
						
						
						
						
						
						
						</trans_lang>
						<trans_word><![CDATA[perform a gut, an exorcism, as tteok, rice cake, is in sight]]></trans_word>
						<trans_dfn><![CDATA[To have a good chance by accident to do something that one has planned to do.]]></trans_dfn>
					</translation>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					<translation>
						<trans_lang>
						
						
						
						
						
						러시아어
						
						
						
						
						
						
						
						</trans_lang>
						<trans_word><![CDATA[(досл.) увидев рисовый хлебец, совершить шаманский обряд]]></trans_word>
						<trans_dfn><![CDATA[При удачном моменте совершить дело, которое планировалось раньше.]]></trans_dfn>
					</translation>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					<example_info>
						<type>
							
							
							문장
							
								
						</type>
						<example>떡 본 김에 굿한다고 이번 설에는 고향에 내려가서 한 며칠 쉬면서 친구들도 좀 보고 올 생각이다.</example>
					</example_info>
					
					
					
					<example_info>
						<type>
							
							
							
							대화
								
						</type>
						<example>컴퓨터 사러 전자 제품 가게에 다녀온다더니 텔레비전을 사 왔구나.</example>
					</example_info>
					
					
					
					<example_info>
						<type>
							
							
							
							대화
								
						</type>
						<example>떡 본 김에 굿한다고 이번에 새 컴퓨터를 사면서 텔레비전도 하나 새로 샀어.</example>
					</example_info>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
				</subsense_info>
				
				
				
				
				
				
				
			</subword_info>
			
			<subword_info>
				<subword>떡 본 김에 제사 지낸다</subword>
				<subword_unit>
					
						
						속담
					
				</subword_unit>
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				<subsense_info>
					<definition>우연히 얻은 좋은 기회에 하려고 했던 일을 한다.</definition>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					<translation>
						<trans_lang>
						
						
						
						
						
						
						영어
						
						
						
						
						
						
						</trans_lang>
						<trans_word><![CDATA[perform an ancestral rite as tteok, rice cake, is in sight]]></trans_word>
						<trans_dfn><![CDATA[To have a good chance by accident to do something that one has planned to do.]]></trans_dfn>
					</translation>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					<translation>
						<trans_lang>
						
						
						
						
						
						러시아어
						
						
						
						
						
						
						
						</trans_lang>
						<trans_word><![CDATA[(досл.) увидев рисовый хлебец, совершить обряд жертвоприношения]]></trans_word>
						<trans_dfn><![CDATA[При удачном моменте совершить дело, которое планировалось раньше.]]></trans_dfn>
					</translation>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					<example_info>
						<type>
							
							
							문장
							
								
						</type>
						<example>떡 본 김에 제사 지낸다고 간만에 직원들이 모두 모인 자리에서 사장님은 간단하게 직원들에게 당부의 말을 몇 마디 했다.</example>
					</example_info>
					
					
					
					<example_info>
						<type>
							
							
							
							대화
								
						</type>
						<example>다음 주에 김장 담그신다면서요. 도와 드리러 갈까요?</example>
					</example_info>
					
					
					
					<example_info>
						<type>
							
							
							
							대화
								
						</type>
						<example>그래. 떡 본 김에 제사 지낸다고 배추를 많이 샀으니 이번에 김치나 많이 담가야겠다.</example>
					</example_info>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
				</subsense_info>
				
				
				
				
				
			</subword_info>
			
			<subword_info>
				<subword>떡 줄 사람은 생각지도 않는데 김칫국부터 마신다</subword>
				<subword_unit>
					
						
						속담
					
				</subword_unit>
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				<subsense_info>
					<definition>해 줄 사람은 생각지도 않는데 미리부터 해 줄 것이라고 알고 행동한다.</definition>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					<translation>
						<trans_lang>
						
						
						
						
						
						
						영어
						
						
						
						
						
						
						</trans_lang>
						<trans_word><![CDATA[drink kimchitguk, kimchi liquid, in advance even if the one who has some tteok, rice cake, is not thinking about giving them to others at all]]></trans_word>
						<trans_dfn><![CDATA[To behave based on the hasty assumption that one will get something when the person who has that something is not even thinking about giving it away.]]></trans_dfn>
					</translation>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					<translation>
						<trans_lang>
						
						
						
						
						
						러시아어
						
						
						
						
						
						
						
						</trans_lang>
						<trans_word><![CDATA[опережать события]]></trans_word>
						<trans_dfn><![CDATA[Выражение, используемое, когда один человек еще не решил сделать что-либо, а другой уже действует так, как если бы тот согласился.]]></trans_dfn>
					</translation>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					<example_info>
						<type>
							
							
							문장
							
								
						</type>
						<example>떡 줄 사람은 생각지도 않는데 김칫국부터 마신다더니 큰형은 아버지가 자신에게 모든 재산을 물려줄 것이라고 굳게 믿고 있었다.</example>
					</example_info>
					
					
					
					<example_info>
						<type>
							
							
							
							대화
								
						</type>
						<example>이번에 김 씨랑 같이 동업하기로 했다면서?</example>
					</example_info>
					
					
					
					<example_info>
						<type>
							
							
							
							대화
								
						</type>
						<example>떡 줄 사람은 생각지도 않는데 김칫국부터 마신다고 나는 아직 대답하지도 않았는데 사람들한테 그렇게 말하고 다니더라고.</example>
					</example_info>
					
					
					
					
					
					
					
					
					
					
				</subsense_info>
				
				
				
			</subword_info>
			
			
		</word_info>
	</item>
	
