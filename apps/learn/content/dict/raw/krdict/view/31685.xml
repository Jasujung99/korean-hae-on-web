			<subword_info>
				<subword>고기는 씹어야 맛을 안다</subword>
				<subword_unit>
					
						
						속담
					
				</subword_unit>
				
				
				
				
				<subsense_info>
					<definition>고기를 씹지 않고 제맛을 알 수 없는 것처럼 일을 직접 해 봐야 참뜻을 안다.</definition>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					<translation>
						<trans_lang>
						
						
						
						
						
						
						영어
						
						
						
						
						
						
						</trans_lang>
						<trans_word><![CDATA[One should chew meat to fully enjoy the flavor]]></trans_word>
						<trans_dfn><![CDATA[One should have firsthand experience to thoroughly understand something as one could never appreciate the flavor of meat before chewing it.]]></trans_dfn>
					</translation>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
