						</trans_lang>
						<trans_word><![CDATA[]]></trans_word>
						<trans_dfn><![CDATA[Как нельзя почувствовать настоящий вкус мяса, не прожевав его, так и невозможно понять истинный смысл работы, дела, не попробовав выполнить его лично.]]></trans_dfn>
					</translation>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					<example_info>
						<type>
							
							
							
							대화
								
						</type>
						<example>돈 버는 일이 이렇게 힘든 줄 몰랐어요.</example>
					</example_info>
					
					
					
					<example_info>
						<type>
							
							
							
							대화
								
						</type>
						<example>고기도 씹어야 맛을 안다고 무슨 일이든 그렇게 해 봐야 제대로 배우는 거야.</example>
					</example_info>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
				</subsense_info>
				
				
				
				
				
				
				
				
				
			</subword_info>
			
