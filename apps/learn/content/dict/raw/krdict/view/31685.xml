				</subword_unit>
				
				
				
				
				
				
				<subsense_info>
					<definition>고기를 씹어야 그 맛을 알 수 있는 것처럼 할 말은 마음에 두지 않고 다 하는 것이 좋다.</definition>
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
					
