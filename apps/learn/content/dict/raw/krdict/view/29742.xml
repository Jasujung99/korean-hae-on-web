					</trans_lang>
					<trans_word><![CDATA[fellow; dude]]></trans_word>
					<trans_dfn><![CDATA[(impolite form or affectionate) A person who is about the same age as or younger than one.]]></trans_dfn>
				</translation>
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
