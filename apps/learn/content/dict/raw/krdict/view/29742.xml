					<trans_dfn><![CDATA[A person that one is close to and in an amicable relationship with.]]></trans_dfn>
				</translation>
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
