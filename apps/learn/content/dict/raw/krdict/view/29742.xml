					<trans_dfn><![CDATA[(груб. или дружеств.) Слово, указывающее на сверстника или человека, стоящего ниже по социальному статусу.]]></trans_dfn>
				</translation>
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				<reference></reference>
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				
				<example_info>
					<type>문장</type>
					<example>이 친구 왜 아직도 안 오는 거야?</example>
				</example_info>
				
				
				
				<example_info>
					<type>문장</type>
					<example>젊은 친구가 노인보다도 정보에 늦으면 되겠어?</example>
				</example_info>
				
				
				
				<example_info>
					<type>문장</type>
					<example>그 친구 신입사원이 벌써부터 지각을 하다니 안 되겠군.</example>
				</example_info>
				
				
				
				
				
				
				
				
				
				
				
