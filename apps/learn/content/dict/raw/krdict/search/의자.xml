				</trans_lang>
				<trans_word><![CDATA[социалист]]></trans_word>
				<trans_dfn><![CDATA[Человек, выступающий за социализацию средств производства и против капитализма, стремясь к созданию общества без личной собственности на производственные средства.]]></trans_dfn>
			</translation>
			
			
			
			
			
			
			
			
			
			
			
			
			
