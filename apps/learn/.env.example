# 학습 앱이 브라우저에 보이는 origin (scheme://host[:port]).
# learn.haeonkorean.com 은 제안 주소일 뿐이며 아직 DNS·운영 주소가 아니다.
LEARN_APP_ORIGIN=http://localhost:4400

# 1 이면 빌드된 서버에서도 검토용 미리보기(역할 전환 막대)를 켠다.
# astro dev 에서는 자동으로 켜진다. 운영 서버에는 설정하지 않는다.
LEARN_PREVIEW=0

# 아래 값은 개발 1단계에서 읽지 않는다. 이후 단계에서 서버 환경 변수로만 넣는다.
# 실제 값은 이 파일이나 저장소에 적지 않는다.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# GEMINI_API_KEY=
