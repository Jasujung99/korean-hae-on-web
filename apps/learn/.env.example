# 앱이 표시할 절대 origin. 비우면 설정된 주소가 없다고 보여 줍니다.
# 이 값을 적어도 DNS, 배포, 인증서, 쿠키 도메인은 바뀌지 않습니다.
# 제안 호스트 이름은 기본값으로 넣지 않습니다.
# LEARN_APP_ORIGIN=http://127.0.0.1:4174

# 1이면 npm start / vite preview에서도 역할 전환 미리보기를 켭니다.
# 개발 서버(npm run dev)는 운영 모드가 아니면 미리보기가 켜집니다.
# 0이면 개발 서버에서도 끕니다. 교사 로그인으로는 쓰지 않습니다.
# LEARN_SCREEN_PREVIEW=0

# npm start가 묶는 주소와 포트.
# HOST=127.0.0.1
# PORT=4174

# 계정 DB(개인 초대·기기 세션·학습 기록·교사 로그인). 네 값을 함께 넣어야 켜집니다.
# 값은 저장소에 적지 않고 실행할 때 환경 변수로만 넣습니다. 브라우저로는 보내지 않습니다.
# LEARN_DB_URL=https://<project-ref>.supabase.co
# LEARN_DB_SECRET_KEY=
# LEARN_DB_PUBLISHABLE_KEY=
# 기기·교사 세션 토큰을 해시하는 서버 비밀값(32자 이상, 무작위).
# LEARN_SESSION_SECRET=

# 초대 링크에 넣을 주소. 비우면 LEARN_APP_ORIGIN(개발 서버는 그 서버 주소)을 씁니다.
# LEARN_INVITE_ORIGIN=

# 개발 서버만: 1이면 같은 와이파이의 휴대폰에서 열 수 있게 이 PC의 내부 주소도 받고,
# 초대 링크를 그 주소로 만듭니다(npm run dev:lan).
# LEARN_LAN=0
