---
import JamoHeadline from "../components/JamoHeadline.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../lib/site";

const title = "해온 haeon · 11월 20일에 만나요";
const description = "한국어를 나답게 말하도록 돕는 해온이 2026년 11월 20일에 문을 열어요. Your voice, in Korean.";
const { threads, letters } = site.links;
---

<BaseLayout title={title} description={description}>
  <div class="opening">
    <JamoHeadline label="11월 20일에 만나요" />
    <div class="details">
      <span class="rule" aria-hidden="true"></span>
      <p class="tagline" lang="en">{site.tagline}</p>
      <p class="date" lang="en">Opening <time datetime={site.opening.date}>{site.opening.label}</time></p>
      <ul class="links" lang="en">
        {
          threads && (
            <li>
              <a class="underline-link" href={threads}>
                Meet us on Threads
              </a>
            </li>
          )
        }
        {threads && <li class="separator" aria-hidden="true">/</li>}
        <li><a class="underline-link" href={letters}>Get our letters</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .opening {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 64px;
    width: min(100%, 1240px);
  }

  .details {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /*
   * Once the jamo pieces have settled (about 4.75s, see JamoHeadline), the block scrolls up
   * from below while it clears, very slowly, from a faint blur.
   */
  .details {
    animation:
      details-rise 3.2s cubic-bezier(0.22, 0.61, 0.36, 1) 4.6s both,
      details-clear 5.5s cubic-bezier(0.4, 0, 0.3, 1) 4.6s both;
  }

  .rule {
    width: 24px;
    height: 1px;
    margin-bottom: 32px;
    background: var(--line-strong);
  }

  .tagline {
    margin: 0;
    color: var(--ink-muted);
    font: 400 18px/28px var(--font-latin);
    letter-spacing: 0.02em;
  }

  .date {
    margin: 14px 0 0;
    color: var(--olive);
    font: 500 34px/44px var(--font-latin);
    letter-spacing: 0.04em;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin: 52px 0 0;
    padding: 0;
    list-style: none;
    font: 400 19px/26px var(--font-latin);
  }

  .separator {
    color: var(--line-strong);
  }

  @keyframes details-rise {
    from {
      transform: translateY(80px);
    }
    to {
      transform: none;
    }
  }

  @keyframes details-clear {
    0% {
      opacity: 0;
      filter: blur(14px);
    }
    25% {
      opacity: 0.3;
      filter: blur(9px);
    }
    100% {
      opacity: 1;
      filter: blur(0);
    }
  }

  @media (max-width: 720px) {
    .opening {
      gap: 44px;
    }

    .rule {
      margin-bottom: 26px;
    }

    .tagline {
      font-size: 16px;
      line-height: 24px;
    }

    .date {
      margin-top: 10px;
      font-size: 26px;
      line-height: 34px;
    }

    .links {
      gap: 4px;
      margin-top: 40px;
      font-size: 17px;
    }
  }
</style>
