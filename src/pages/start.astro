---
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../lib/site";

const title = "내게 맞는 한국어 학습 시작하기 | 해온";
const description = "무료 발음 체크, 한글 학습 키트, 맞춤 한국어 수업 중 지금 필요한 시작점을 골라보세요.";
---

<BaseLayout title={title} description={description} canonicalPath="/start/" noindex bodyClass="start-page">
  <PageHero
    kicker="WHERE WILL YOU BEGIN?"
    title="오늘 필요한 한국어부터 고르세요"
    lead="지금 가장 해결하고 싶은 한 가지를 선택하면, 결제나 신청 전에 자세한 안내를 먼저 확인할 수 있습니다."
    facts={[
      { label: "발음 점검", value: `${siteConfig.coaching.duration} · ${siteConfig.coaching.price}` },
      { label: "혼자 학습", value: "PDF · 영상 키트" },
      { label: "함께 학습", value: "목표별 맞춤 수업" },
    ]}
    analyticsLocation="start-hero"
  />

  <section class="content-section start-routes" aria-labelledby="start-routes-title">
    <div class="page-shell">
      <div class="section-heading">
        <p class="page-kicker">CHOOSE YOUR NEXT STEP</p>
        <h2 id="start-routes-title">지금의 고민과 가장 가까운 길</h2>
        <p>선택해도 바로 결제되거나 수업이 확정되지 않습니다. 각 페이지에서 내용과 조건을 충분히 확인하세요.</p>
      </div>

      <div class="route-grid start-route-grid">
        <article class="route-card" data-accent="primary" aria-labelledby="start-coaching-title">
          <div>
            <p class="route-number">PRONUNCIATION CHECK</p>
            <h3 id="start-coaching-title">내 발음을 먼저 점검하고 싶어요</h3>
            <p>짧은 온라인 1:1 체크로 막히는 소리를 찾고, 다음 연습 방향을 안내받습니다.</p>
          </div>
          <a
            class="route-link"
            href="/events/free-pronunciation-coaching/"
            data-analytics-event="select_learning_path"
            data-analytics-id="start-path-coaching"
            data-analytics-location="start-router"
            data-destination-path="/events/free-pronunciation-coaching/"
            data-learning-path="coaching"
          >무료 발음 체크 알아보기 <span aria-hidden="true">→</span></a>
        </article>

        <article class="route-card" aria-labelledby="start-kit-title">
          <div>
            <p class="route-number">SELF-STUDY</p>
            <h3 id="start-kit-title">혼자 차근차근 배우고 싶어요</h3>
            <p>한글 모음의 원리부터 발음 연습까지 PDF와 영상으로 내 속도에 맞춰 익힙니다.</p>
          </div>
          <a
            class="route-link"
            href="/study-kits/"
            data-analytics-event="select_learning_path"
            data-analytics-id="start-path-study-kit"
            data-analytics-location="start-router"
            data-destination-path="/study-kits/"
            data-learning-path="study_kit"
          >학습 키트 보기 <span aria-hidden="true">→</span></a>
        </article>

        <article class="route-card" aria-labelledby="start-classes-title">
          <div>
            <p class="route-number">CLASSES</p>
            <h3 id="start-classes-title">목표에 맞는 수업을 찾고 싶어요</h3>
            <p>1:1 한국어, KIIP 보조, 온라인과 충청권 수업 중 나에게 맞는 방식을 비교합니다.</p>
          </div>
          <a
            class="route-link"
            href="/classes/"
            data-analytics-event="select_learning_path"
            data-analytics-id="start-path-classes"
            data-analytics-location="start-router"
            data-destination-path="/classes/"
            data-learning-path="classes"
          >수업 살펴보기 <span aria-hidden="true">→</span></a>
        </article>

        <article class="route-card route-card-unsure" aria-labelledby="start-unsure-title">
          <div>
            <p class="route-number">NOT SURE YET</p>
            <h3 id="start-unsure-title">아직 어디서 시작할지 모르겠어요</h3>
            <p>현재 어려운 점을 짧게 알려주세요. 바로 신청을 권하기보다 가장 가벼운 다음 단계를 함께 찾겠습니다.</p>
          </div>
          <a
            class="route-link"
            href="/contact/"
            data-analytics-event="select_learning_path"
            data-analytics-id="start-path-contact"
            data-analytics-location="start-router"
            data-destination-path="/contact/"
            data-learning-path="contact"
          >가볍게 문의하기 <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .start-routes {
    background:
      radial-gradient(circle at 88% 15%, rgb(115 210 203 / 0.12), transparent 24rem),
      linear-gradient(180deg, rgb(247 252 254 / 0.35), rgb(234 246 250 / 0.72));
  }

  .start-route-grid {
    align-items: stretch;
  }

  .start-route-grid .route-card {
    min-height: 19rem;
  }

  .start-route-grid .route-card[data-accent="primary"] {
    min-height: 24rem;
  }

  .route-card-unsure {
    grid-column: span 2;
    min-height: 14rem !important;
    background:
      linear-gradient(120deg, rgb(255 255 255 / 0.9), rgb(234 246 250 / 0.82)),
      var(--color-bg-soft);
  }

  .route-card-unsure > div {
    max-width: 43rem;
  }

  .route-link {
    width: fit-content;
  }

  .route-link:focus-visible {
    border-radius: var(--radius-xs);
    outline: 3px solid rgb(93 157 232 / 0.38);
    outline-offset: 5px;
  }

  @media (max-width: 980px) {
    .start-route-grid .route-card[data-accent="primary"],
    .route-card-unsure {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .start-route-grid .route-card,
    .start-route-grid .route-card[data-accent="primary"],
    .route-card-unsure {
      grid-column: auto;
      min-height: auto !important;
    }
  }
</style>
