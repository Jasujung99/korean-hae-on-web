---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="찾는 쪽이 없어요 · 해온 haeon"
  description="찾는 쪽이 없어요. 해온 첫 화면에서 다시 시작해 보세요."
  canonicalPath="/404/"
  noindex
>
  <div class="missing">
    <p class="code" lang="en">404</p>
    <h1>찾는 쪽이 없어요.</h1>
    <p>주소를 다시 확인해 보세요.</p>
    <a class="underline-link" href="/">첫 화면으로</a>
  </div>
</BaseLayout>

<style>
  .missing {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .code {
    margin: 0;
    color: var(--olive);
    font: var(--text-numeral);
  }

  h1 {
    margin: 12px 0 0;
    font: var(--text-doc-title);
  }

  p {
    margin: 8px 0 0;
    font: var(--text-doc-body);
  }

  .underline-link {
    margin-top: 24px;
    font: var(--text-doc-body);
  }
</style>
