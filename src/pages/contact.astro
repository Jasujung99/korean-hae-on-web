---
import LeadForm from "../components/LeadForm.astro";
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { absoluteUrl, siteConfig } from "../lib/site";

const title = "한국어 수업·학습 자료 문의 | 해온";
const description = "무료 발음 체크, 한국어 수업, 학습 키트와 협업에 관해 해온에 문의하세요.";
const contactPoint = siteConfig.contactEmail
  ? {
      "@type": "ContactPoint",
      email: siteConfig.contactEmail,
      contactType: "customer support",
      availableLanguage: ["Korean", "English"],
    }
  : undefined;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "@id": absoluteUrl("/contact/") + "#page",
    name: "해온 문의",
    description,
    url: absoluteUrl("/contact/"),
    about: { "@id": absoluteUrl("/") + "#organization" },
    ...(contactPoint ? { mainEntity: contactPoint } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "홈", item: absoluteUrl("/") },
      { "@type": "ListItem", position: 2, name: "문의", item: absoluteUrl("/contact/") },
    ],
  },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    kicker="CONTACT HAEON"
    title="어떤 도움이 필요한지 알려주세요"
    lead="수업, 학습 키트, 협업과 관련된 질문을 남겨주시면 확인 후 이메일로 답변드리겠습니다."
    facts={[
      { label: "답변", value: siteConfig.responseTime },
      { label: "수업 방식", value: "온라인 우선" },
      { label: "안내 언어", value: "한국어 · English" },
    ]}
    primary={{ href: "#contact-form", label: "문의 작성하기", analyticsId: "contact-hero-form" }}
    secondary={{ href: "/start/", label: "시작 경로 먼저 보기", analyticsId: "contact-hero-start", variant: "secondary" }}
    analyticsLocation="contact-hero"
  />

  <section class="content-section">
    <div class="page-shell">
      <div class="section-heading">
        <p class="page-kicker">BEFORE YOU WRITE</p>
        <h2>목적에 맞는 가장 빠른 경로</h2>
        <p>무료 발음 체크와 수업 상담은 전용 신청서가 있어 필요한 내용을 한 번에 전달할 수 있습니다.</p>
      </div>
      <div class="route-grid contact-routes">
        <article class="route-card" data-accent="primary">
          <div>
            <span class="route-number">FREE CHECK</span>
            <h3>내 발음을 먼저 점검하고 싶어요</h3>
            <p>20분 온라인 1:1 흐름과 준비할 내용을 확인한 뒤 신청하세요.</p>
          </div>
          <a class="route-link" href="/events/free-pronunciation-coaching/" data-analytics-event="cta_click" data-analytics-id="contact-route-coaching" data-analytics-location="contact-routes" data-destination-path="/events/free-pronunciation-coaching/">무료 발음 체크 <span aria-hidden="true">→</span></a>
        </article>
        <article class="route-card">
          <div>
            <span class="route-number">CLASSES</span>
            <h3>수업 상담이 필요해요</h3>
            <p>1:1·소그룹·KIIP 보조 수업의 차이를 확인하고 상담을 신청하세요.</p>
          </div>
          <a class="route-link" href="/classes/#inquiry" data-analytics-event="cta_click" data-analytics-id="contact-route-classes" data-analytics-location="contact-routes" data-destination-path="/classes/#inquiry">수업 알아보기 <span aria-hidden="true">→</span></a>
        </article>
        <article class="route-card">
          <div>
            <span class="route-number">STUDY KIT</span>
            <h3>자료나 결제를 문의하고 싶어요</h3>
            <p>샘플과 현재 판매 상태를 먼저 확인하면 더 정확히 안내받을 수 있습니다.</p>
          </div>
          <a class="route-link" href="/study-kits/" data-analytics-event="cta_click" data-analytics-id="contact-route-kits" data-analytics-location="contact-routes" data-destination-path="/study-kits/">학습 키트 보기 <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </div>
  </section>

  <section id="contact-form" class="content-section form-section" aria-labelledby="contact-form-title">
    <div class="page-shell form-layout">
      <div class="section-heading">
        <p class="page-kicker">GENERAL INQUIRY</p>
        <h2 id="contact-form-title">문의 내용을 남겨주세요</h2>
        <p>내용을 확인한 뒤 {siteConfig.responseTime}에 입력한 이메일로 답변합니다.</p>
        <dl class="contact-facts">
          <div><dt>무료 발음 체크</dt><dd>전용 신청 페이지 권장</dd></div>
          <div><dt>수업 상담</dt><dd>목표와 가능한 시간 포함</dd></div>
          <div><dt>환불 요청</dt><dd><a href="/refund/">환불 안내와 요청 양식</a></dd></div>
        </dl>
        {siteConfig.contactEmail ? (
          <p class="direct-email">폼을 보내기 어렵다면 <a href={"mailto:" + siteConfig.contactEmail}>{siteConfig.contactEmail}</a>로 문의하세요.</p>
        ) : (
          <p class="form-mode-notice">공개 전 운영 이메일을 연결할 예정입니다. 현재는 개발용 폼 흐름만 확인할 수 있습니다.</p>
        )}
      </div>
      <LeadForm
        variant="contact"
        endpoint={siteConfig.inquiryFormEndpoint}
        successPath="/thanks/inquiry/?type=contact"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-routes {
    align-items: stretch;
  }

  .form-section {
    background: rgb(234 246 250 / 0.42);
  }

  .contact-facts {
    display: grid;
    gap: 0;
    margin-top: 2rem;
    border-top: 1px solid var(--color-line-strong);
  }

  .contact-facts div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    border-bottom: 1px solid var(--color-line);
    padding: 1rem 0;
  }

  .contact-facts dt {
    color: var(--color-text-primary);
    font-weight: 650;
  }

  .contact-facts dd,
  .direct-email {
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .direct-email {
    margin-top: 1.5rem;
  }

  @media (max-width: 480px) {
    .contact-facts div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
