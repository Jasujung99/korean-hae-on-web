---
import SoundTeaser from "../../components/SoundTeaser.astro";
import VideoShelf from "../../components/VideoShelf.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../lib/site";
import { tiktokProfile } from "../../lib/teaser";

const title = "듣고 고르기 · 해온 소리 연습 맛보기";
const description = "ㅈ·ㅊ·ㅉ 세 소리를 듣고 빈칸에 들어갈 첫소리를 골라 보세요. 해온 소리 연습에서 옮겨 온 세 문항이에요. Listen, then choose.";
const { letters } = site.links;
---

<BaseLayout title={title} description={description}>
  <div class="sori">
    <a class="back" href="/">← 첫 화면</a>

    <header class="intro">
      <p class="label">해온 소리 연습 · 맛보기</p>
      <h1 class="title">듣고 고르기</h1>
      <span class="line" aria-hidden="true"></span>
      <p class="meta">ㅈ · ㅊ · ㅉ <span aria-hidden="true">/</span> 세 문항 <span aria-hidden="true">/</span> 기록 없음</p>
      <p class="latin" lang="en">Listen, then choose.</p>
    </header>

    <SoundTeaser />

    <aside class="more">
      <h2 class="more-title">더 연습하려면</h2>
      <p>소리 연습은 해온 선생님이 초대하면 이어서 할 수 있어요. 소식은 편지로 먼저 전해요.</p>
      <p lang="en"><a class="underline-link" href={letters}>Get our letters</a></p>
    </aside>

    <section class="videos" aria-labelledby="videos-title">
      <h2 class="videos-title" id="videos-title">짧은 영상도 있어요</h2>
      <p class="videos-body">영상을 누르면 그 자리에서 틱톡 플레이어를 불러와요.</p>
      <VideoShelf />
      <p class="videos-link" lang="en"><a class="underline-link" href={tiktokProfile}>@haeonkorean ↗</a></p>
    </section>
  </div>
</BaseLayout>

<style>
  .sori {
    width: min(100%, 560px);
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-muted);
    font: 400 15px/1 var(--font-serif);
  }

  .intro {
    margin: 24px 0 36px;
  }

  .label {
    margin: 0;
    color: var(--ink-muted);
    font: 400 14px/22px var(--font-serif);
  }

  .title {
    margin: 6px 0 0;
    color: var(--olive);
    font: 600 34px/44px var(--font-serif);
  }

  .line {
    display: block;
    height: 1px;
    margin: 18px 0 14px;
    background: var(--line-strong);
  }

  .meta {
    margin: 0;
    font: 400 15px/24px var(--font-serif);
  }

  .meta span {
    margin: 0 6px;
    color: var(--line-strong);
  }

  .latin {
    margin: 4px 0 0;
    color: var(--ink-muted);
    font: 400 17px/24px var(--font-latin);
  }

  .more {
    margin-top: 48px;
    padding: 24px;
    border-radius: var(--radius-sm);
    background: var(--wash-lavender);
  }

  .more-title,
  .videos-title {
    margin: 0;
    font: 600 19px/28px var(--font-serif);
  }

  .more p {
    margin: 8px 0 0;
    font: 400 15px/24px var(--font-serif);
  }

  .more .underline-link {
    padding-left: 0;
    font: 400 18px/26px var(--font-latin);
  }

  .more .underline-link::after {
    left: 0;
  }

  .videos {
    margin-top: 56px;
  }

  .videos-body {
    margin: 6px 0 20px;
    color: var(--ink-muted);
    font: 400 15px/24px var(--font-serif);
  }

  .videos-link {
    margin: 16px 0 0;
    text-align: center;
    font: 400 18px/26px var(--font-latin);
  }
</style>
