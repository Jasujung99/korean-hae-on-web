---
import { audioUrl, consonants, teaserItems, voices } from "../lib/teaser";

const first = teaserItems[0];
const data = JSON.stringify({
  items: teaserItems,
  voices,
  audio: Object.fromEntries(
    teaserItems.map((item) => [
      item.id,
      Object.fromEntries(
        voices.map((voice) => [voice.key, { word: audioUrl(item.id, "word", voice.key), sentence: audioUrl(item.id, "sentence", voice.key) }]),
      ),
    ]),
  ),
});
---

<section class="teaser" data-teaser={data} aria-label="듣고 고르기 맛보기">
  <div class="top">
    <p class="kicker"><span class="numeral" lang="en">01</span> 듣고 고르기 · 낱말 첫소리</p>
    <ol class="dots" aria-hidden="true">
      {teaserItems.map(() => <li></li>)}
    </ol>
    <p class="count" data-count>1 / {teaserItems.length}</p>
  </div>

  <div class="quiz" data-quiz>
    <div class="listen-row">
      <button class="listen" type="button" data-listen aria-label="소리 들려주기">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5.5v13l10.5-6.5z"></path></svg>
      </button>
      <p class="caption" data-caption aria-live="polite">먼저 소리를 들어요.</p>
    </div>

    <div class="stage" role="img" data-stage aria-label="첫소리 자리가 비어 있어요">
      <span class="slot" data-slot></span><span class="vowel" data-vowel>{first.vowel}</span><span class="rest" data-rest>{first.rest}</span>
    </div>
    <p class="stage-note">낱말의 첫째 소리 · 첫소리만 골라요</p>

    <div class="prompt" data-prompt>
      <p class="prompt-title">어떤 소리였나요?</p>
      <p class="prompt-body">조각 하나를 골라 빈칸에 놓아 보세요.</p>
    </div>

    <div class="result" data-result hidden>
      <p class="result-title" data-result-title></p>
      <p class="result-body" data-result-body></p>
      <p class="sticker" data-sticker hidden>잘 들었어요.</p>
    </div>

    <div class="tray" role="group" aria-label="첫소리 조각">
      {
        consonants.map((consonant) => (
          <button class="piece" type="button" data-piece={consonant}>
            <span>{consonant}</span>
            <svg class="ring" viewBox="0 0 120 100" aria-hidden="true" focusable="false">
              <path d="M64 9C33 4 9 23 10 51C11 80 39 96 68 92C97 88 114 67 110 43C106 21 84 6 50 11" />
            </svg>
          </button>
        ))
      }
    </div>

    <article class="word" data-word hidden>
      <p class="kicker"><span class="numeral" lang="en">02</span> 새 단어</p>
      <h3 class="word-title" data-word-title></h3>
      <p class="word-meta" data-word-meta></p>
      <span class="rule" aria-hidden="true"></span>
      <p class="gloss" data-gloss></p>
      <p class="example" data-example></p>
      <div class="voices" role="group" aria-label="목소리별로 낱말과 예문 듣기">
        {
          voices.map((voice) => (
            <button class="voice" type="button" data-voice={voice.key}>
              {voice.label}
            </button>
          ))
        }
      </div>
      <button class="next" type="button" data-next>다음 소리</button>
    </article>
  </div>

  <div class="done" data-done hidden>
    <p class="result-title">세 소리를 다 들었어요.</p>
    <p class="result-body" data-done-body></p>
    <button class="next" type="button" data-restart>처음부터 다시</button>
  </div>
</section>

<script>
  interface Item {
    id: string;
    word: string;
    answer: string;
    vowel: string;
    rest: string;
    pos: string;
    scene: string;
    gloss: string;
    example: string;
  }
  interface Data {
    items: Item[];
    voices: { key: string; label: string }[];
    audio: Record<string, Record<string, { word: string; sentence: string }>>;
  }

  let player: HTMLAudioElement | null = null;
  let queue: string[] = [];

  function play(urls: string[], onEnd?: () => void) {
    player?.pause();
    queue = [...urls];
    const next = () => {
      const url = queue.shift();
      if (!url) {
        onEnd?.();
        return;
      }
      player = new Audio(url);
      player.addEventListener("ended", next, { once: true });
      player.play().catch(() => onEnd?.());
    };
    next();
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-teaser]")) {
    const data = JSON.parse(root.dataset.teaser ?? "{}") as Data;
    const $ = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const dots = [...root.querySelectorAll<HTMLElement>(".dots li")];
    const pieces = [...root.querySelectorAll<HTMLButtonElement>("[data-piece]")];
    const voiceButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-voice]")];

    let index = 0;
    let plays = 0;
    let score = 0;
    let answered = false;

    const item = () => data.items[index];

    function render() {
      const current = item();
      $("[data-quiz]").hidden = false;
      $("[data-done]").hidden = true;
      $("[data-count]").textContent = `${index + 1} / ${data.items.length}`;
      dots.forEach((dot, i) => dot.classList.toggle("is-on", i < index || (i === index && answered)));
      $("[data-slot]").textContent = "";
      $("[data-slot]").classList.remove("is-filled");
      $("[data-vowel]").textContent = current.vowel;
      $("[data-rest]").textContent = current.rest;
      $("[data-stage]").setAttribute("aria-label", "첫소리 자리가 비어 있어요");
      $("[data-caption]").textContent = "먼저 소리를 들어요.";
      $("[data-prompt]").hidden = false;
      $("[data-result]").hidden = true;
      $("[data-word]").hidden = true;
      for (const piece of pieces) {
        piece.disabled = false;
        piece.classList.remove("is-answer", "is-wrong", "is-dim");
        piece.setAttribute("aria-label", piece.dataset.piece ?? "");
      }
      plays = 0;
      answered = false;
    }

    function listen() {
      const button = $<HTMLButtonElement>("[data-listen]");
      button.classList.add("is-playing");
      play([data.audio[item().id].charon.word], () => button.classList.remove("is-playing"));
      plays += 1;
      $("[data-caption]").textContent = answered
        ? `${plays}번 들었어요 · 누르면 다시 들려줘요`
        : plays === 1
          ? "들었으면 아래에서 조각을 골라요."
          : `${plays}번 들었어요 · 누르면 다시 들려줘요`;
    }

    function choose(picked: string) {
      if (answered) return;
      answered = true;
      const current = item();
      const right = picked === current.answer;
      if (right) score += 1;

      $("[data-slot]").textContent = picked;
      $("[data-slot]").classList.add("is-filled");
      $("[data-stage]").setAttribute("aria-label", `고른 조각 ${picked}이 빈칸에 놓였어요`);
      dots[index]?.classList.add("is-on");

      for (const piece of pieces) {
        const value = piece.dataset.piece;
        piece.disabled = true;
        piece.classList.toggle("is-answer", value === current.answer);
        piece.classList.toggle("is-wrong", value === picked && !right);
        piece.classList.toggle("is-dim", value !== current.answer && value !== picked);
        const notes = [value === current.answer ? "맞는 소리" : "", value === picked ? "내가 고른 소리" : ""].filter(Boolean);
        piece.setAttribute("aria-label", [value, ...notes].join(", "));
      }

      $("[data-prompt]").hidden = true;
      $("[data-result]").hidden = false;
      $("[data-result-title]").textContent = `${current.word}였어요.`;
      $("[data-result-body]").textContent = right
        ? `${current.answer} 소리를 또렷하게 가려 들었어요.`
        : `고른 조각은 ${picked}, 들린 소리는 ${current.answer}. 한 번 더 들어 보면 차이가 들려요.`;
      $("[data-sticker]").hidden = !right;
      if (plays > 0) $("[data-caption]").textContent = `${plays}번 들었어요 · 누르면 다시 들려줘요`;

      $("[data-word-title]").textContent = current.word;
      $("[data-word-meta]").textContent = `${current.pos} / ${current.scene}`;
      $("[data-gloss]").textContent = current.gloss;
      $("[data-example]").textContent = current.example;
      $("[data-next]").textContent = index < data.items.length - 1 ? `다음 소리 · ${index + 2} / ${data.items.length}` : "마치기";
      $("[data-word]").hidden = false;
    }

    function next() {
      player?.pause();
      if (index < data.items.length - 1) {
        index += 1;
        render();
        $<HTMLButtonElement>("[data-listen]").focus();
        return;
      }
      $("[data-quiz]").hidden = true;
      $("[data-done]").hidden = false;
      $("[data-done-body]").textContent = `${data.items.length}문항 중 ${score}문항을 가려 들었어요. 기록은 남지 않아요.`;
      $<HTMLButtonElement>("[data-restart]").focus();
    }

    $("[data-listen]").addEventListener("click", listen);
    for (const piece of pieces) piece.addEventListener("click", () => choose(piece.dataset.piece ?? ""));
    for (const button of voiceButtons) {
      button.addEventListener("click", () => {
        const urls = data.audio[item().id][button.dataset.voice ?? "charon"];
        for (const other of voiceButtons) other.classList.toggle("is-playing", other === button);
        play([urls.word, urls.sentence], () => button.classList.remove("is-playing"));
      });
    }
    $("[data-next]").addEventListener("click", next);
    $("[data-restart]").addEventListener("click", () => {
      index = 0;
      score = 0;
      render();
    });
  }
</script>

<style>
  .teaser [hidden] {
    display: none;
  }

  .teaser {
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
    text-align: left;
  }

  .top {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line-strong);
  }

  .kicker {
    margin: 0;
    color: var(--ink);
    font: 500 15px/22px var(--font-serif);
  }

  .numeral {
    margin-right: 6px;
    color: var(--olive);
    font: 500 17px/22px var(--font-latin);
  }

  .dots {
    display: flex;
    gap: 6px;
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
  }

  .dots li {
    width: 9px;
    height: 9px;
    border: 1px solid var(--olive);
    border-radius: var(--radius-pill);
    background: var(--wash-sage);
  }

  .dots li.is-on {
    background: var(--olive);
  }

  .count {
    margin: 0;
    color: var(--ink-muted);
    font: 400 15px/22px var(--font-latin);
  }

  .listen-row {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 26px;
  }

  .listen {
    display: grid;
    flex: none;
    place-items: center;
    width: 72px;
    height: 72px;
    border: 1.5px solid var(--olive);
    border-radius: var(--radius-pill);
    background: var(--paper);
    color: var(--olive);
    cursor: pointer;
  }

  .listen svg {
    width: 26px;
    height: 26px;
    fill: currentColor;
  }

  .listen:hover,
  .listen.is-playing {
    background: var(--wash-sage);
  }

  .listen:focus-visible,
  .piece:focus-visible,
  .voice:focus-visible,
  .next:focus-visible {
    outline: 2px solid var(--olive);
    outline-offset: 3px;
  }

  .caption {
    margin: 0;
    color: var(--ink-muted);
    font: 400 15px/24px var(--font-serif);
  }

  .stage {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    margin-top: 28px;
    color: var(--olive);
    font: 700 64px/1 var(--font-serif);
  }

  .slot {
    display: grid;
    place-items: center;
    width: 76px;
    height: 84px;
    border: 2px dashed var(--line-strong);
    border-radius: var(--radius-sm);
  }

  .slot.is-filled {
    border: 0;
    background: var(--wash-sage);
  }

  .vowel {
    color: #9a84b3;
  }

  .rest {
    margin-left: 10px;
    color: var(--line-strong);
    font-size: 44px;
  }

  .stage-note {
    margin: 12px 0 0;
    color: var(--ink-muted);
    font: 400 13px/20px var(--font-serif);
    text-align: center;
  }

  .prompt,
  .result {
    position: relative;
    margin-top: 24px;
    text-align: center;
  }

  .prompt-title,
  .result-title {
    margin: 0;
    color: var(--ink);
    font: 600 21px/30px var(--font-serif);
  }

  .prompt-body,
  .result-body {
    margin: 6px 0 0;
    color: var(--ink-muted);
    font: 400 15px/24px var(--font-serif);
  }

  .sticker {
    display: inline-block;
    margin: 14px 0 0;
    padding: 2px 16px;
    border-radius: var(--radius-pill);
    background: var(--lavender);
    color: var(--lavender-ink);
    font: 400 24px/32px var(--font-hand);
    transform: rotate(-4deg);
  }

  .tray {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 22px;
    padding: 14px;
    border-radius: var(--radius-sm);
    background: var(--wash-sage);
  }

  .piece {
    position: relative;
    min-height: 76px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--olive);
    font: 700 44px/1 var(--font-serif);
    cursor: pointer;
  }

  .piece:hover:not(:disabled) {
    border-color: var(--olive);
  }

  .piece:disabled {
    cursor: default;
  }

  .piece.is-dim {
    opacity: 0.45;
  }

  .piece.is-wrong span {
    text-decoration: line-through 2px var(--coral);
  }

  .ring {
    position: absolute;
    inset: -6px -2px;
    width: calc(100% + 4px);
    height: calc(100% + 12px);
    fill: none;
    stroke: var(--lavender-ink);
    stroke-width: 2.5;
    stroke-linecap: round;
    opacity: 0;
    pointer-events: none;
  }

  .piece.is-answer .ring {
    opacity: 1;
  }

  .word {
    margin-top: 28px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }

  .word-title {
    margin: 14px 0 0;
    color: var(--olive);
    font: 600 34px/44px var(--font-serif);
  }

  .word-meta {
    margin: 2px 0 0;
    color: var(--ink-muted);
    font: 400 14px/22px var(--font-serif);
  }

  .rule {
    display: block;
    width: 24px;
    height: 1px;
    margin: 16px 0;
    background: var(--line-strong);
  }

  .gloss {
    margin: 0;
    font: 400 17px/28px var(--font-serif);
  }

  .example {
    margin: 12px 0 0;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--wash-sage);
    font: 400 16px/26px var(--font-serif);
  }

  .voices {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .voice {
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: var(--paper);
    color: var(--ink);
    font: 400 14px/1 var(--font-serif);
    cursor: pointer;
  }

  .voice:hover,
  .voice.is-playing {
    border-color: var(--olive);
    background: var(--wash-sage);
  }

  .next {
    display: block;
    width: 100%;
    min-height: 48px;
    margin-top: 20px;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--olive);
    color: var(--on-olive, var(--paper));
    font: 500 16px/1 var(--font-serif);
    cursor: pointer;
  }

  .done {
    margin-top: 28px;
    text-align: center;
  }
</style>
