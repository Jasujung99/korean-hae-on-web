---
import type { VideoSeries } from "../lib/videoSeries";

interface Props {
  poster: string;
  title: string;
  seriesTitle: string;
  tone: VideoSeries["tone"];
  badge?: string;
  compact?: boolean;
}

const { poster, title, seriesTitle, tone, badge, compact = false } = Astro.props;
---

<span class={`vthumb vthumb--${tone} ${compact ? "vthumb--compact" : ""}`}>
  <span class="vthumb-fallback" aria-hidden="true">
    <span class="vthumb-series">{seriesTitle}</span>
    <span class="vthumb-title">{title}</span>
  </span>
  <img
    src={poster}
    alt=""
    width="540"
    height="960"
    loading="lazy"
    decoding="async"
    data-poster-img
    onerror="this.hidden=true"
  />
  {badge && <span class="vthumb-badge">{badge}</span>}
</span>

<style>
  .vthumb {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--line);
  }

  .vthumb--sage {
    background: var(--wash-sage);
    border-color: var(--sage);
    color: var(--olive);
  }

  .vthumb--lavender {
    background: var(--wash-lavender);
    border-color: var(--lavender);
    color: var(--lavender-ink);
  }

  .vthumb--leaf {
    background: #f1f0e1;
    border-color: var(--leaf);
    color: var(--olive);
  }

  .vthumb-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    padding: 12px 10px;
    text-align: left;
  }

  .vthumb-series {
    font: 500 11px/16px var(--font-serif);
    opacity: 0.78;
  }

  .vthumb-title {
    color: var(--ink);
    font: 600 13px/19px var(--font-serif);
    word-break: keep-all;
  }

  .vthumb--compact .vthumb-fallback {
    padding: 8px;
    gap: 4px;
  }

  .vthumb--compact .vthumb-series {
    font-size: 10px;
    line-height: 14px;
  }

  .vthumb--compact .vthumb-title {
    font-size: 11.5px;
    line-height: 16px;
  }

  .vthumb img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vthumb-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 2;
    padding: 2px 8px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: var(--paper);
    color: var(--ink);
    font: 500 11px/16px var(--font-serif);
  }

  .vthumb--compact .vthumb-badge {
    top: 6px;
    left: 6px;
    padding: 1px 6px;
    font-size: 10px;
  }
</style>
