---
import { playerUrl, teaserVideos } from "../lib/teaser";

interface Props {
  /** `grid`: 큰 포스터 줄(휴대폰 탭), `compact`: 작은 포스터 줄(PC 카드) */
  variant?: "grid" | "compact";
}

const { variant = "grid" } = Astro.props;
---

<div class={`shelf shelf--${variant}`} data-shelf>
  <div class="stage" data-stage hidden>
    <iframe
      data-frame
      title="틱톡 영상"
      allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
      allowfullscreen
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"></iframe>
    <button class="close" type="button" data-close>영상 닫기</button>
  </div>
  <ul class="posters">
    {
      teaserVideos.map((video) => (
        <li>
          <button
            class="poster"
            type="button"
            data-video={video.id}
            data-src={playerUrl(video.id)}
            data-title={video.title}
            aria-label={`${video.title} 영상 보기`}
          >
            <span class="cover">
              <img src={video.poster} alt="" width="540" height="960" loading="lazy" decoding="async" />
              <span class="play" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M8 5.5v13l10.5-6.5z" />
                </svg>
              </span>
            </span>
            <span class="series">{video.series}</span>
            <span class="title">{video.title}</span>
          </button>
        </li>
      ))
    }
  </ul>
</div>

<script>
  // 포스터만 먼저 보이고, 누른 뒤에야 틱톡 플레이어를 불러온다(그 전에는 틱톡에 요청이 가지 않는다).
  for (const shelf of document.querySelectorAll<HTMLElement>("[data-shelf]")) {
    const stage = shelf.querySelector<HTMLElement>("[data-stage]")!;
    const frame = shelf.querySelector<HTMLIFrameElement>("[data-frame]")!;
    const posters = [...shelf.querySelectorAll<HTMLButtonElement>("[data-video]")];

    const close = () => {
      frame.removeAttribute("src");
      stage.hidden = true;
      shelf.classList.remove("is-playing");
      for (const poster of posters) poster.removeAttribute("aria-current");
    };

    for (const poster of posters) {
      poster.addEventListener("click", () => {
        frame.src = poster.dataset.src ?? "";
        frame.title = `틱톡 영상: ${poster.dataset.title ?? ""}`;
        stage.hidden = false;
        shelf.classList.add("is-playing");
        for (const other of posters) other.toggleAttribute("aria-current", other === poster);
        poster.setAttribute("aria-current", "true");
        stage.scrollIntoView({ block: "nearest", behavior: "smooth" });
      });
    }

    shelf.querySelector("[data-close]")!.addEventListener("click", () => {
      const current = posters.find((poster) => poster.hasAttribute("aria-current"));
      close();
      current?.focus();
    });

    // 숨겨진 쪽(휴대폰 탭이나 PC 카드)에서 재생 중이면 화면 너비가 바뀔 때 멈춘다.
    new ResizeObserver(() => {
      if (shelf.offsetParent === null && !stage.hidden) close();
    }).observe(document.documentElement);
  }
</script>

<style>
  .shelf {
    width: 100%;
  }

  .stage {
    position: relative;
    width: min(100%, 320px);
    margin: 0 auto 20px;
  }

  .stage iframe {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--ink);
  }

  .close {
    display: block;
    min-height: 44px;
    margin: 6px auto 0;
    padding: 0 14px;
    border: 0;
    background: none;
    color: var(--ink-muted);
    font: 400 14px/1 var(--font-serif);
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .posters {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .poster {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    text-align: left;
    cursor: pointer;
  }

  .cover {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-md);
    outline: 2px solid transparent;
    outline-offset: 2px;
  }

  .cover img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 16;
    object-fit: cover;
  }

  .poster[aria-current] .cover {
    outline-color: var(--olive);
  }

  .poster:focus-visible {
    outline: none;
  }

  .poster:focus-visible .cover {
    outline-color: var(--olive);
  }

  .play {
    position: absolute;
    left: 10px;
    bottom: 10px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1.5px solid var(--olive);
    border-radius: var(--radius-pill);
    background: var(--paper);
    color: var(--olive);
  }

  .play svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .series {
    margin-top: 8px;
    color: var(--ink-muted);
    font: 400 12px/18px var(--font-serif);
  }

  .title {
    margin-top: 2px;
    font: 500 14px/20px var(--font-serif);
  }

  /* 재생 중에는 포스터가 작은 목록으로 줄어든다. */
  .shelf.is-playing .posters {
    grid-template-columns: repeat(3, minmax(0, 88px));
    justify-content: center;
  }

  .shelf.is-playing .series,
  .shelf.is-playing .title,
  .shelf.is-playing .play {
    display: none;
  }

  .shelf--compact .posters {
    gap: 10px;
  }

  .shelf--compact .play {
    width: 34px;
    height: 34px;
    left: 8px;
    bottom: 8px;
  }

  .shelf--compact .title {
    font-size: 13px;
    line-height: 18px;
  }
</style>
