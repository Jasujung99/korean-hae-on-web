---
import ButtonLink from "./ButtonLink.astro";

interface Fact {
  label: string;
  value: string;
}

interface Action {
  href: string;
  label: string;
  analyticsId: string;
  variant?: "primary" | "secondary" | "quiet";
  external?: boolean;
  disabled?: boolean;
}

interface Props {
  kicker: string;
  title: string;
  lead: string;
  facts?: Fact[];
  primary?: Action;
  secondary?: Action;
  analyticsLocation: string;
}

const {
  kicker,
  title,
  lead,
  facts = [],
  primary,
  secondary,
  analyticsLocation,
} = Astro.props;
---

<section class="page-hero">
  <div class="page-shell page-hero-grid">
    <div>
      <p class="page-kicker">{kicker}</p>
      <h1 class="page-title">{title}</h1>
      <p class="page-lead">{lead}</p>
      {(primary || secondary) && (
        <div class="hero-actions">
          {primary && <ButtonLink {...primary} analyticsLocation={analyticsLocation} />}
          {secondary && <ButtonLink {...secondary} analyticsLocation={analyticsLocation} />}
        </div>
      )}
    </div>
    {facts.length > 0 && (
      <aside class="page-hero-aside" aria-label="핵심 안내">
        <dl class="fact-list">
          {facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
        </dl>
      </aside>
    )}
  </div>
</section>
