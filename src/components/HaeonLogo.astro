---
import logoSource from "../design-system/logos/logo-olive.svg?raw";

function pathOf(id: string) {
  const match = logoSource.match(new RegExp(`id="${id}" d="([^"]+)"`));
  if (!match) throw new Error(`logo-olive.svg has no #${id} path`);
  return match[1];
}

const mark = pathOf("mark");
const nameKo = pathOf("name-ko");
const nameEn = pathOf("name-en");
---

<a class="logo" href="/" aria-label="해온 haeon 첫 화면">
  <svg class="mark" viewBox="0 -1 241 180" aria-hidden="true" focusable="false"><path d={mark}></path></svg>
  <svg class="name" viewBox="12 201 190 142" aria-hidden="true" focusable="false">
    <path d={nameKo}></path>
    <path d={nameEn}></path>
  </svg>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: flex-end;
    gap: 10px;
    color: var(--olive);
  }

  svg {
    display: block;
    height: auto;
    fill: currentColor;
  }

  .mark {
    width: 64px;
  }

  .name {
    width: 56px;
  }

  @media (max-width: 720px) {
    .mark {
      width: 50px;
    }

    .name {
      width: 44px;
    }
  }
</style>
